cabal-version:       2.4
name:                adjunctions-flipped
version:             0.1.0.0
synopsis:            Adjunctions flipped with Codistributive and Corepresentable
homepage:            https://github.com/ashokkimmel/adjunctions-flipped
license:             BSD-3-Clause
author:              Author
maintainer:          author@example.com
category:            Data
build-type:          Simple

library
  exposed-modules:     Data.Functor.Codistributive
                     , Data.Functor.Corepresentable
                     , Data.Functor.Adjunct
  build-depends:       base >= 4.7 && < 5
                     , distributive >= 0.6
                     , adjunctions >= 4.4
                     , transformers >= 0.5
                     , comonad >= 5.0
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite adjunctions-flipped-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  other-modules:       
  build-depends:       base >= 4.7 && < 5
                     , adjunctions-flipped
                     , hspec >= 2.0
  hs-source-dirs:      test
  default-language:    Haskell2010
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N
